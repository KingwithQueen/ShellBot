if(NOT DEFINED IDENTITY OR IDENTITY STREQUAL "" OR NOT EXISTS "${TARGET}")
  message(FATAL_ERROR "Explicit signing identity and an existing target are required.")
endif()
if(IDENTITY STREQUAL "-")
  set(timestamp --timestamp=none)
  set(runtime)
else()
  set(timestamp --timestamp)
  set(runtime --options runtime)
endif()
set(identifier)
if("${TARGET}" MATCHES "libpdfium\\.dylib$")
  set(identifier --identifier org.shellbot.pdfium)
endif()
execute_process(COMMAND /usr/bin/codesign --force --sign "${IDENTITY}" ${runtime} ${timestamp} ${identifier} "${TARGET}"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot sign ${TARGET}: ${error}")
endif()
execute_process(COMMAND /usr/bin/codesign --verify --strict "${TARGET}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot verify signed target: ${error}")
endif()
