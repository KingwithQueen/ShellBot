{
  "format_version": 1,
  "gateway": {
    "port": 8765
  },
  "projects": [
    {
      "id": "development",
      "token_env": "SHELLBOT_DEVELOPMENT_TOKEN",
      "data_dir": "/absolute/private/DevelopmentData",
      "workspaces": [
        {
          "id": "workspace",
          "path": "/absolute/development",
          "read_only": false
        }
      ],
      "policy": {
        "approval_mode": "always",
        "files": {
          "scope": "current_user",
          "current_user_read_only": false
        },
        "execution": {
          "enabled": true,
          "default_identity": "current_user",
          "administrator_allowed": true
        },
        "tools": [
          "host_info",
          "host_capabilities",
          "fs_list",
          "fs_read",
          "fs_search",
          "fs_write",
          "fs_patch",
          "fs_stat",
          "fs_mkdir",
          "fs_copy",
          "fs_move",
          "fs_delete",
          "task_start",
          "task_status",
          "task_output",
          "task_input",
          "task_cancel",
          "approval_status",
          "approval_cancel",
          "image_view",
          "document_info",
          "document_read",
          "document_preview",
          "artifact_download",
          "artifact_upload"
        ]
      },
      "resources": {
        "max_active_tasks": 8,
        "max_task_records": 32,
        "max_output_bytes": 262144,
        "max_timeout_ms": 3600000,
        "max_approval_records": 64,
        "worker_memory_mb": 512
      }
    }
  ]
}
